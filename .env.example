# Contact form email delivery (src/pages/ContactPage.jsx).
# 1. Create a free form at https://formspree.io and verify the inbox that
#    should receive submissions (e.g. connect@workintel.ai).
# 2. Copy its endpoint (looks like https://formspree.io/f/xxxxxxxx) below.
# 3. Add the same variable in Vercel: Project Settings -> Environment
#    Variables -> add for Production and Preview -> redeploy.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
